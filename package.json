{
  "name": "vanilla-todomvc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small, accessible TodoMVC built with vanilla JavaScript.",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
